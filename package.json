{
  "name": "@andestec/persistencia-redis",
  "version": "0.1.0",
  "description": "Capa de persistencia sobre Redis: primitivas PersistenciaSet/Get/Check e interfaz tipo repositorio.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs/index.d.ts",
      "default": "./dist/nestjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enternet-SA/persistencia-redis.git"
  },
  "homepage": "https://github.com/Enternet-SA/persistencia-redis#readme",
  "bugs": {
    "url": "https://github.com/Enternet-SA/persistencia-redis/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "redis": "^6.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0 <13.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/testing": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
